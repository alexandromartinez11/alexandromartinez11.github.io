<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Contact | Alexandro Martinez</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
<div class="wrap">
  <header class="top">
    <a class="brand" href="index.html">alexandro<span>@</span>martinez<span>:~$</span></a>
    <nav>
      <a href="about.html">About Me</a>
      <a class="on" href="contact.html">Contact</a>
      <a href="https://www.linkedin.com/in/alexandromartinez-cybersecurity" target="_blank" rel="noopener">LinkedIn ↗</a>
    </nav>
  </header>
  <div class="hero">
    <div>
      <h1>Contact Me</h1>
      <p class="tag">Send me a message</p>
    </div>
  </div>

  <section class="card">
    <h2>message</h2>
    <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
      <label for="n">Name</label>
      <input id="n" name="name" type="text" required autocomplete="name">
      <label for="e">Email</label>
      <input id="e" name="email" type="email" required autocomplete="email">
      <label for="m">Message</label>
      <textarea id="m" name="message" rows="6" required></textarea>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none">
      <button class="btn p" type="submit">Send message</button>
    </form>
  </section>
</div>
</body>
